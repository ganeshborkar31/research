# Application
APP_ENV=dev
APP_PORT=8000

# PostgreSQL (Compose service names work inside Docker; use localhost when running locally)
POSTGRES_DB=knowledge_ai
POSTGRES_USER=knowledge_ai
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://knowledge_ai:change-this-password@postgres:5432/knowledge_ai

# Optional explicit SQLAlchemy URLs. DATABASE_URL is sufficient for both.
# ASYNC_POSTGRES_URL=postgresql+asyncpg://knowledge_ai:change-this-password@postgres:5432/knowledge_ai
# SYNC_POSTGRES_URL=postgresql+psycopg://knowledge_ai:change-this-password@postgres:5432/knowledge_ai
# POSTGRES_URL=

# Docker Compose admin UI
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-this-password

# Infrastructure
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10
QDRANT_BATCH_SIZE=128
QDRANT_COLLECTION_NAME=rag_chunks_v1
QDRANT_VECTOR_SIZE=1536
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# RAG ingestion
RAG_SOURCE_ROOT=./data/documents
RAG_INGESTION_MAX_RETRIES=5
RAG_INGESTION_LEASE_SECONDS=900
RAG_INGESTION_DISPATCH_AFTER_SECONDS=60
RAG_INGESTION_CHUNK_SIZE=512
RAG_INGESTION_CHUNK_OVERLAP=64

# Email / OTP notifications (leave blank to disable SMTP delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Knowledge AI
SMTP_SUBJECT_PREFIX=Knowledge AI
SMTP_APP_NAME=Knowledge AI
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_REQUIRE_AUTH=true
SMTP_TIMEOUT_SECONDS=15

# LLM and embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
USE_LANGGRAPH_CHAT=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=0.25
EMBEDDING_TIMEOUT_SECONDS=30
HUGGINGFACE_API_TOKEN=

# Support agent
SUPPORT_POLICY_PATH=
SUPPORT_KB_USER_FALLBACK=__support__

# Twilio voice / SMS integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PUBLIC_BASE_URL=
DEFAULT_VOICE_AGENT_ID=general

# Speech-to-text: auto, gemini, whisper, or stub
VOICE_STT_PROVIDER=auto
VOICE_STT_TIMEOUT_SECONDS=20
VOICE_STT_GEMINI_MODEL=gemini-2.0-flash
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1

# Text-to-speech: auto, elevenlabs, openai, azure, or stub
VOICE_TTS_PROVIDER=auto
VOICE_TTS_TIMEOUT_SECONDS=20
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
VOICE_TTS_ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
VOICE_TTS_ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
VOICE_TTS_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
VOICE_TTS_OPENAI_MODEL=gpt-4o-mini-tts
VOICE_TTS_OPENAI_VOICE=alloy
VOICE_TTS_OPENAI_FORMAT=mp3
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
VOICE_TTS_AZURE_VOICE_NAME=en-US-JennyNeural
VOICE_TTS_AZURE_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=15
REFRESH_TOKEN_EXP_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
OTP_EXP_MINUTES=10
OTP_LENGTH=6
